#Creating and Manipulating Objects
#vector
marks <- c(80, 75, 90, 85, 88)
cat("Vector:\n")
print(marks)
# Manipulating vector
cat("\nFirst three elements of vector:\n")
print(marks[1:3])
cat("\nSum of marks:\n")
print(sum(marks))
# Creating a matrix
m <- matrix(1:6, nrow = 2, ncol = 3)
cat("\nMatrix:\n")
print(m)
# Manipulating matrix
cat("\nElement at row 1, column 2:\n")
print(m[1, 2])
# Creating a list
student <- list(
Name = "Riya",
Age = 20,
Marks = c(85, 90, 88)
)
cat("\nList:\n")
print(student)
cat("\nStudent Name:\n")
print(student$Name)
# Creating sequences
seq1 <- 1:10
seq2 <- seq(1, 20, by = 2)
cat("\nSequence using : operator:\n")
print(seq1)
cat("\nSequence using seq() function:\n")
print(seq2)
# a. Creation of Data Frame
