# Step 1: Download dataset
url <- "https://gist.githubusercontent.com/Satish0329/a2fa2c15e4e6b857442c197d0765966f/raw/student_scores.csv"
# Step 2: Read dataset
students <- read.csv(url)
# Step 1: Download dataset
url <- "https://gist.githubusercontent.com/Satish0329/a2fa2c15e4e6b857442c197d0765966f/raw/student_scores.csv"
# Step 2: Read dataset
students <- read.csv(url)
# Step 3: Display dataset
print(students)
# Step 4: Analyze structure
cat("\n--- Structure of Dataset ---\n")
str(students)
# Step 5: Display first records
cat("\n--- First Records ---\n")
print(head(students))
# Step 6: Display last records
cat("\n--- Last Records ---\n")
print(tail(students))
# Step 7: Display dimensions
cat("\n--- Dimensions ---\n")
print(dim(students))
# Step 8: Display column names
cat("\n--- Column Names ---\n")
print(names(students))
# Step 9: Select two numerical values
x <- as.numeric(students$math[1])
y <- as.numeric(students$science[1])
cat("\nMaths Marks:", x, "\n")
cat("Science Marks:", y, "\n")
# Step 10: Arithmetic Operators
cat("\n--- Arithmetic Operators ---\n")
cat("Addition:", x + y, "\n")
cat("Subtraction:", x - y, "\n")
cat("Multiplication:", x * y, "\n")
cat("Division:", x / y, "\n")
cat("Modulus:", x %% y, "\n")
cat("Integer Division:", x %/% y, "\n")
cat("Power:", x ^ y, "\n")
# Step 11: Mathematical Functions
cat("\n--- Miscellaneous Mathematical Functions ---\n")
cat("Absolute Value:", abs(x - y), "\n")
cat("Square Root:", sqrt(x), "\n")
cat("Ceiling:", ceiling(x / 3), "\n")
cat("Floor:", floor(x / 3), "\n")
cat("Round:", round(x / y, 2), "\n")
cat("Logarithm:", log(x), "\n")
cat("Log Base 10:", log10(x), "\n")
cat("Exponential:", exp(x / 10), "\n")
cat("Sine:", sin(x), "\n")
cat("Cosine:", cos(x), "\n")
cat("Tangent:", tan(x), "\n")
# Step 12: Statistical Summary
cat("\n--- Statistical Summary ---\n")
print(summary(students))
# Load dplyr package
library(dplyr)
install.packages("dplyr")
# Load dplyr package
library(dplyr)
# Import the downloaded dataset
students <- read.csv("students.csv")
# Load dplyr
library(dplyr)
# Create dataset
students <- data.frame(
Name = c("Aman", "Riya", "Karan", "Simran", "Rahul"),
Age = c(20, 21, 19, 20, 22),
Marks = c(85, 90, 76, 88, 70),
Grade = c("A", "A", "B", "A", "B")
)
# Display dataset
print(students)
# Display dimensions
dim(students)
# Display structure
glimpse(students)
